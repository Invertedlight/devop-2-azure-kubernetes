#!/bin/bash

/usr/local/bin/mise trust /workspaces/$DEVPOD_WORKSPACE_ID/mise.toml && /usr/local/bin/mise install

curl -sL https://aka.ms/InstallAzureCLIDeb | sudo bash

curl -sSfL \
  https://github.com/cloudnative-pg/cloudnative-pg/raw/main/hack/install-cnpg-plugin.sh |
  sudo sh -s -- -b /usr/local/bin

# Flux deploy key for mercury-gitops (Terraform reads ~/.ssh/mercury).
# The key lives on the persistent workspace volume; only the link is recreated.
KEY_DIR="/workspaces/$DEVPOD_WORKSPACE_ID/.keys"
if [ -f "$KEY_DIR/mercury" ]; then
  mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
  ln -sf "$KEY_DIR/mercury" "$HOME/.ssh/mercury"
  ln -sf "$KEY_DIR/mercury.pub" "$HOME/.ssh/mercury.pub"
fi

# Dotfiles and zsh login shell. The home folder starts fresh whenever the pod
# is recreated, so re-apply James's chezmoi dotfiles and set zsh as the shell.
if command -v chezmoi >/dev/null 2>&1 && [ ! -d "$HOME/.local/share/chezmoi/.git" ]; then
  if [ -e "$HOME/.local/share/chezmoi" ]; then
    mv "$HOME/.local/share/chezmoi" "$HOME/.local/share/chezmoi.old-$(date +%Y%m%d%H%M%S)"
  fi
  chezmoi init --apply https://github.com/Invertedlight/dotfiles.git
fi
if [ -x /usr/bin/zsh ] && ! grep -q "^$(id -un):.*:/usr/bin/zsh$" /etc/passwd; then
  sudo chsh -s /usr/bin/zsh "$(id -un)"
fi
