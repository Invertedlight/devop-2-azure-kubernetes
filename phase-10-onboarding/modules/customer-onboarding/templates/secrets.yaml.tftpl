apiVersion: secrets-store.csi.x-k8s.io/v1
kind: SecretProviderClass
metadata:
  name: ${customer_name}-secrets
spec:
  provider: azure
  parameters:
    usePodIdentity: "false"
    useVMManagedIdentity: "true"
    userAssignedIdentityID: "${aks_keyvault_identity_client_id}"
    keyvaultName: "${keyvault_name}"
    tenantId: "${keyvault_tenant_id}"
    objects: |
      array:
        - |
          objectName: ${customer_name}-db-user
          objectType: secret
        - |
          objectName: ${customer_name}-db-password
          objectType: secret
        - |
          objectName: storage-account-name
          objectType: secret
        - |
          objectName: ${customer_name}-blob-sas
          objectType: secret
        - |
          objectName: ${customer_name}-telegram-bot-token
          objectType: secret
        - |
          objectName: ${customer_name}-telegram-chat-id
          objectType: secret
  secretObjects:
    - secretName: ${customer_name}-db-credentials
      type: kubernetes.io/basic-auth
      data:
        - objectName: ${customer_name}-db-user
          key: username
        - objectName: ${customer_name}-db-password
          key: password
    - secretName: ${customer_name}-n8n-env
      type: Opaque
      data:
        - objectName: ${customer_name}-db-user
          key: DB_POSTGRESDB_USER
        - objectName: ${customer_name}-db-password
          key: DB_POSTGRESDB_PASSWORD
    - secretName: ${customer_name}-backup-creds
      type: Opaque
      data:
        - objectName: storage-account-name
          key: storage-account-name
        - objectName: ${customer_name}-blob-sas
          key: ${customer_name}-blob-sas
    - secretName: ${customer_name}-telegram-creds
      type: Opaque
      data:
        - objectName: ${customer_name}-telegram-bot-token
          key: TELEGRAM_BOT_TOKEN
        - objectName: ${customer_name}-telegram-chat-id
          key: TELEGRAM_CHAT_ID
